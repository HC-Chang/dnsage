# Pi-hole
PIHOLE_PASSWORD=changeme

# PostgreSQL
POSTGRES_USER=donuthole
POSTGRES_PASSWORD=changeme
POSTGRES_DB=donuthole

# pgAdmin (debug profile only)
PGADMIN_EMAIL=admin@donuthole.com
PGADMIN_PASSWORD=changeme

# JWT / Auth (generate with: openssl rand -hex 32)
JWT_SECRET=changeme
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# CORS - add your host IP for external access
CORS_ORIGINS=https://localhost

# HTTPS / Caddy
# For a public deployment, use DNS names pointing to this host and ports 80/443 open.
# With the defaults, Caddy uses its local CA for https://localhost and https://pihole.localhost.
DOMAIN=localhost
PIHOLE_DOMAIN=pihole.localhost

# LLM - use local Ollama only
LLM_PROVIDER_CHAIN=ollama
LLM_MODELS={"ollama":"llama3.2"}

# Embedding (vector similarity learning)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=all-minilm:33m
EMBEDDING_DIMENSIONS=384
OLLAMA_BASE_URL=http://ollama:11434
